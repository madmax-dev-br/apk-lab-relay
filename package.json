{
  "name": "apk-lab-relay",
  "version": "0.1.0",
  "description": "Desktop CORS relay for APK Browser Lab: lets the lab reach any server without CORS errors.",
  "private": true,
  "main": "src/relay.cjs",
  "bin": { "apk-lab-relay": "src/relay.cjs" },
  "scripts": {
    "start": "node src/relay.cjs",
    "test": "node --test \"test/**/*.test.cjs\"",
    "build": "node scripts/build-sea.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  }
}
